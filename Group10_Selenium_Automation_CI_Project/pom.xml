<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.group10</groupId>
  <artifactId>campustrack-selenium-tests</artifactId>
  <version>1.0.0</version>
  <name>CampusTrack - Selenium, TestNG, ExtentReports CI</name>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <selenium.version>4.51.0</selenium.version>
    <testng.version>7.11.0</testng.version>
    <extent.version>5.1.2</extent.version>
    <surefire.version>3.5.2</surefire.version>
    <baseUrl>http://127.0.0.1:8000</baseUrl>
    <headless>true</headless>
  </properties>
  <dependencies>
    <dependency><groupId>org.seleniumhq.selenium</groupId><artifactId>selenium-java</artifactId><version>${selenium.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.testng</groupId><artifactId>testng</artifactId><version>${testng.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.aventstack</groupId><artifactId>extentreports</artifactId><version>${extent.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version><configuration><release>${maven.compiler.release}</release></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>${surefire.version}</version>
        <configuration>
          <suiteXmlFiles><suiteXmlFile>testng.xml</suiteXmlFile></suiteXmlFiles>
          <systemPropertyVariables><baseUrl>${baseUrl}</baseUrl><headless>${headless}</headless></systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace><rerunFailingTestsCount>0</rerunFailingTestsCount>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
